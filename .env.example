# 서버 설정 예시 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# PORT 는 게임 안 [설정 → 서버 · 포트]에서도 바꿀 수 있습니다.
PORT=3001
NODE_ENV=production

# 관리자 계정 (서버 시작 시 자동 생성/갱신)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=여기에_강력한_비밀번호를_넣으세요
ADMIN_NICKNAME=관리자

# JWT 서명 키 (비워두면 서버가 무작위 생성)
# AUTH_SECRET — 로그인 토큰 서명 키. 반드시 설정하세요.
#  만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=여기에_64자_무작위_문자열
# 다른 PC 가 접속할 수 있게 모든 출처를 허용한다(마인크래프트 멀티처럼).
CLIENT_ORIGIN=*

# 인터넷 공유 주소 (cloudflared/ngrok 터널·도메인). 설정하면 초대 링크가 이 주소로 만들어집니다.
# 비워 두면 LAN 주소를 쓰므로 같은 공유기 안에서만 초대 링크가 열립니다.
# PUBLIC_URL=https://your-tunnel.example.com
